                    "path": "intensity",
                    "constraints": {
                      "min": 0,
                      "max": 300000,
                      "step": 1,
                      "default": "16000"
                    }
                  },
                  {
                    "component": "core::LightSource",
                    "widget": "RangeField",
                    "label": "Inner Angle",
                    "path": "type.spot.innerAngle",
                    "constraints": {
                      "min": 0,
                      "max": 180,
                      "step": 1,
                      "default": "30"
                    }
                  },
                  {
                    "component": "core::LightSource",
                    "widget": "RangeField",
                    "label": "Outer Angle",
                    "path": "type.spot.outerAngle",
                    "constraints": {
                      "min": 0,
                      "max": 180,
                      "step": 1,
                      "default": "40"
                    }
                  }
                ],
                "columns": 1
              },
              {
                "id": "shadow-mask",
                "items": [
                  {
                    "component": "core::LightSource",
                    "widget": "FileUploadField",
                    "label": "Shadow Mask Texture",
                    "path": "shadowMaskTexture.tex.texture.src",
                    "props": {}
                  }
                ]
              }
            ],
            "helpTooltip": {
              "text": "A spotlight that can be used to illuminate a scene."
            },
            "version": 2
          }
        }
